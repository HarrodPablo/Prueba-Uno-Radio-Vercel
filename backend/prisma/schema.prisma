generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  dni       String   @unique
  name      String
  phone     String
  email     String?  @unique
  role      UserRole @default(PATIENT)
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studiesAsPatient Study[]  @relation("PatientStudies")
  studiesAsDoctor  Study[]  @relation("DoctorStudies")
  reports          Report[]

  // ✅ Índices reales útiles
  @@index([role])
  @@index([createdAt])

  @@map("users")
}

model Study {
  id               String   @id @default(cuid())
  patientId        String
  doctorId         String
  orthancId        String?
  type             String
  StudyDescription String?
  imageUrl         String?
  originalFilename String?
  imageWidth       Int?
  imageHeight      Int?
  studyInstanceUid String?
  notes            String?
  status           StudyStatus @default(PENDING)
  date             DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient User     @relation("PatientStudies", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User     @relation("DoctorStudies", fields: [doctorId], references: [id])
  reports Report[]

  // ✅ Índices importantes
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([orthancId])

  // 🔥 los que realmente impactan
  @@index([patientId, date])
  @@index([doctorId, date])
  @@index([status, date])

  @@map("studies")
}

model Report {
  id        String   @id @default(cuid())
  studyId   String   @unique
  doctorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  study  Study @relation(fields: [studyId], references: [id], onDelete: Cascade)
  doctor User  @relation(fields: [doctorId], references: [id])

  // ✅ Índices útiles
  @@index([doctorId])
  @@index([createdAt])

  @@map("reports")
}

enum UserRole {
  ADMIN
  DOCTOR
  PATIENT
}

enum StudyStatus {
  PENDING
  IMPORTED
  COMPLETED
}
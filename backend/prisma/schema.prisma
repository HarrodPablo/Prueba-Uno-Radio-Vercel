generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  dni       String   @unique
  name      String
  phone     String
  email     String?  @unique
  role      UserRole @default(PATIENT)
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studiesAsPatient Study[]  @relation("PatientStudies")
  studiesAsDoctor  Study[]  @relation("DoctorStudies")
  reports          Report[]

  @@map("users")
}

model Study {
  id               String   @id @default(cuid())
  patientId        String
  doctorId         String
  orthancId        String? // ID del estudio en Orthanc PACS
  type             String
  StudyDescription  String? // Descripción del estudio desde Orthanc DICOM
  imageUrl         String? // Ruta relativa al WebP: uploads/radiografias/xxx.webp
  originalFilename String? // Nombre original del archivo Agfa
  imageWidth       Int? // Ancho en pixels (del original Agfa)
  imageHeight      Int? // Alto en pixels (del original Agfa)
  studyInstanceUid String? // UID de instancia DICOM desde Orthanc
  notes            String?
  status           StudyStatus @default(PENDING) // Estado del estudio: PENDING, IMPORTED, COMPLETED
  date             DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient User     @relation("PatientStudies", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User     @relation("DoctorStudies", fields: [doctorId], references: [id])
  reports Report[]

  @@map("studies")
}

model Report {
  id        String   @id @default(cuid())
  studyId   String   @unique
  doctorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  study  Study @relation(fields: [studyId], references: [id], onDelete: Cascade)
  doctor User  @relation(fields: [doctorId], references: [id])

  @@map("reports")
}

enum UserRole {
  ADMIN
  DOCTOR
  PATIENT
}

enum StudyStatus {
  PENDING    // Pendiente de importar desde Orthanc
  IMPORTED   // Importado pero no completado
  COMPLETED  // Completado y listo
}
